// timer is initiated on login, in scripts\player\scripts\global.rs2
[timer,general_macro_events]
// make sure this is before afk_event is called, to retain the 'queueing' behavior for random event spawning
if (~macro_event_allowed = false) { 
    return;
}
if (afk_event = ^true) {
    // random events arent restricted in wildy? https://youtu.be/uPKaH7yg4To?t=421
    // Not restricted in banks: https://youtu.be/1Rz9Eg4ZHhA
    ~macro_event_general_spawn(~macro_event_set_random);
}


// this is called during:
// - alching. Confirmed: https://youtu.be/2nqpZoHUjSc?list=PLn23LiLYLb1Y3P9S9qZbijcJihiD416jT
// - teleporting. Confirmed: https://youtu.be/ZtnrEwb0n48?list=PLn23LiLYLb1Y3P9S9qZbijcJihiD416jT&t=51
// (probably every spell)
// - cooking. Confirmed: https://youtu.be/Brq99Bdl0aI?list=PLn23LiLYLb1Y3P9S9qZbijcJihiD416jT&t=198
// - cooking on a range: https://youtu.be/Tix1wbx3YCc?t=343
// - using flax wheel. Confirmed: https://youtu.be/sW48OR1I86M (early osrs)
// - using anvil? Cant find a video, not implemented.
// - fletching? Cant find a video, not implemented.
// - flax picking? Cant find a video, but it is implemented.
// - smithing at furnace. Confirmed? https://youtu.be/a6NobmSGBYw
// - crafting at furnace. Confirmed: https://youtu.be/7pS6s5rvvEY
[proc,macro_event_general_spawn](int $event)
if (~macro_event_allowed = false) { 
    return;
}
def_coord $event_coord = map_findsquare(coord, 1, 1, ^map_findsquare_lineofwalk);
if ($event_coord = null) {
    return;
}
%macro_event = $event;
def_npc $event_npc = ~macro_event_npc($event);
npc_add($event_coord, $event_npc, 1000);
%macro_event_uid = npc_uid;
session_log(^log_moderator, "Random event spawned: <nc_debugname(npc_type)>");
switch_int ($event) {
    case ^macro_swarm : ~macro_swarm_spawn;
    case ^macro_triffidseed : ~macro_event_triffid_spawn;
    case ^macro_dwarf : ~macro_dwarf_spawn;
    case ^macro_geni : ~macro_geni_spawn;
    case ^macro_mysterious_old_man, ^macro_cube, ^macro_mime, ^macro_maze : ~macro_mysterious_old_man_spawn($event);
}

[proc,macro_event_area](coord $coord)(boolean)
if (~in_duel_arena($coord) = true) {
    return(false);
}
if (~inzone_coord_pair_table(gnomeball_zones, coord) = true) {
    return(false);
}
if (~inzone_coord_pair_table(trawler_game_zones, $coord) = true | ~inzone_coord_pair_table(trawler_wreck_zones, $coord) = true) { // allowed on boat in pre-game https://youtu.be/7-gUR40Nr8M
    return(false);
}
if (~in_tutorial_island($coord) = true) {
    return(false);
}
if (~inzone_coord_pair_table(games_room_zones, $coord) = true) { // https://runescape.salmoneus.net/forums/topic/244971-no-random-events/ Not sure about '04 - 07' but in '08 they weren't allowed. Were updated to be allowed in 2009.
    return(false);
}
return(true);

[proc,macro_event_allowed]()(boolean)
if (~macro_event_area(coord) = false) {
    return(false);
}
// if this var isnt reset on npc delete, then youll never get a random event: https://youtu.be/vRlOfkCCGkw
if (%macro_event > 0) {
    return(false);
}
return(true);

// called when the player logs in
[queue,macro_event_login]
def_int $macro_event = %macro_event;
%macro_event = 0;
if (nc_param(~macro_event_npc($macro_event), follow_player_on_logout) = ^true) {
    ~macro_event_general_spawn($macro_event);
}

[proc,macro_event_logout]
if (npc_finduid(%macro_event_uid) = true) {
    %npc_macro_event_target = null;
}

[proc,macro_event_npc](int $event)(npc)
return(enum(int, npc, general_macro_events, $event));

[proc,macro_event_set_random]()(int)
def_int $random = ~random_range(1, enum_getoutputcount(general_macro_events));
switch_int(random(67)) {
    case 0 : mes("Reminder: Monkey business is strictly forbidden.");
    case 1 : mes("Reminder: Meatpuppets are against the rules.");
    case 2 : mes("You have gained one duck point.");
    case 3 : mes("You have lost one duck point.");
    case 4 : mes("User tutti frutti829 has been banned.");
    case 5 : mes("Seismic activity detected.");
    case 6 : mes("Oh dear, you are bread.");
    case 7 : mes("Congratulations, you just advanced a skullduggery level.");
    case 8 : mes("Fruit salad has been disabled.");
    case 9 : mes("Beware of Rodents of Unusual Size.");
    case 10 : mes("Snacks are available at the minibar.");
    case 11 : mes("You get some magic logs.");
    case 12 : mes("Extra dragons can be requested at the checkout counter.");
    case 13 : mes("Reminder: Bananas are not free.");
    case 14 : mes("The Great Chicken is amused.");
    case 15 : mes("Something smells funny...");
    case 16 : mes("Warning: Hippos ahead.");
    case 17 : mes("Zezima has logged in.");
    case 18 : mes("Juggling privileges have been revoked.");
    case 19 : mes("Depth charges have been set.");
    case 20 : mes("Your cat has evolved into a sphinx. Watch out!");
    case 21 : mes("Flights to Morytania have been postponed until April.");
    case 22 : mes("Camping is not allowed in this area.");
    case 23 : mes("Don't turn around.");
    case 24 : mes("Whatever you do, don't blink.");
    case 25 : mes("The Empty Lord stirs.");
    case 26 : mes("Sending trade offer...");
    case 27 : mes("Get your axes from Bob's Axes.");
    case 28 : mes("Your Ultimate Ability is now charged!");
    case 29 : mes("You suddenly feel cold.");
    case 30 : mes("I heard Guthix snores.");
    case 31 : mes("Listen close, they don't want me to tell you this.");
    case 32 : mes("The ground begins to shake.");
    case 33 : mes("Someone is watching.");
    case 34 : mes("Why are we here?");
    case 35 : mes("The bomb has been planted.");
    case 36 : mes("Hold on, how did you do that?");
    case 37 : mes("Nobody, um, nobody expects the, um, err... the Spanish Inquisition!");
    case 38 : mes("Report to your nearest Democracy Officer for re-education.");
    case 39 : mes("The sound of sinister laughter echoes in the distance.");
    case 40 : mes("This doesn't seem physically possible!");
    case 41 : mes("If anyone offers you a jelly rune, do not accept it! We're still not sure what it does.");
    case 42 : mes("Oi, stop clicking on me!");
    case 43 : mes("Hey, that tickles.");
    case 44 : mes("What's that ticking sound?");
    case 45 : mes("Has anyone seen the sky? I seem to have lost it.");
    case 46 : mes("Slime is falling from the sky!");
    case 47 : mes("You swing your inferno adze at the tree.");
    case 48 : mes("Wait there a second.");
    case 49 : mes("You should not stay here.");
    case 50 : mes("There is something very wrong with this place.");
    case 51 : mes("There is now a sale on at DFS.");
    case 52 : mes("Discounted blueberry pie can now be bought from King Roald.");
    case 53 : mes("Double kill. Triple kill. OVERKILL.");
    case 54 : mes("You do not have a spade which you have the level to use.");
    case 55 : mes("Your duck points have been refunded.");
    case 56 : mes("Reminder: If your hitpoints drop to zero, you die.");
    case 57 : mes("Come quick, there's a drop party happening in deep wilderness!");
    case 58 : mes("Watch out for sudden cave-ins.");
    case 59 : mes("a q p");
    case 60 : mes("Your chances of being killed by The Thing are low, but never zero.");
    case 61 : mes("Sorry, I didn't quite catch that.");
    case 62 : mes("Get your free Twisted Bow, now available at the farming guild.");
    case 63 : mes("Warning: Do not feed the cows.");
    case 64 : mes("You catch an elephant. Good luck fitting it in your inventory.");
    case 65 : mes("You catch some piranhas.");
    case 66 : mes("You have run out of duck points.");
    case 67 : mes("You have completed the double duck challenge.");
}
if ($random >= ^teleport_macro_start & (random(4) ! 0 | ~wilderness_level(coord) > 20)) {
    //Only give teleport events 25% of the time they are rolled and only under 20 wildy
    while ($random >= ^teleport_macro_start) {
        $random = ~random_range(1, sub(^teleport_macro_start, 1));
    }
}

if(map_members = ^false) {
    while($random = ^macro_triffidseed) $random = ~random_range(1, sub(^teleport_macro_start, 1));
}
return($random);

// used for skilling random events
[proc,macro_event_general_count]()(int)
def_int $count = enum_getoutputcount(general_macro_events);
if(map_members = ^false) $count = sub($count, ^members_macro_count);
return($count);

// teleports the player to a random location, using the coords in configs/macro_events_teleports.enum
[queue,macro_event_fail_teleport]
session_log(^log_adventure, "Failed random event and got teleported");
def_coord $teleport_coord;
if (map_members = ^true) {
    $teleport_coord = enum(int, coord, macro_event_fail_teleports_members, random(enum_getoutputcount(macro_event_fail_teleports_members)));
} else {
    $teleport_coord = enum(int, coord, macro_event_fail_teleports_free, random(enum_getoutputcount(macro_event_fail_teleports_free)));
}
// https://youtu.be/MS7ADB-hh18
// doesnt if_close
%macro_event = ^no_macro_event;
p_delay(1);
// https://youtu.be/g5k3XuXxyYQ?list=PLn23LiLYLb1Y3P9S9qZbijcJihiD416jT&t=37
spotanim_map(smokepuff, coord, 124, 0);
sound_synth(smokepuff2, 1, 0);
~tele_checks;
//--
~p_telejump_safe($teleport_coord); // todo: Confirm this

// called when the npc needs to be poofed away
[proc,macro_event_disappear]
if (npc_findhero = ^true) {
    sound_synth(smokepuff2, 1, 0);
}
spotanim_map(smokepuff, npc_coord, 124, 0);
npc_del;

[proc,macro_event_lost]()(boolean)
if (finduid(%npc_macro_event_target) = true) {
    if (%macro_event_uid ! npc_uid) {
        return(true);
    }
    if (~macro_event_area(coord) = false) {
        return(true);
    }
    // https://youtu.be/vRlOfkCCGkw?t=87
    if (coordy(coord) ! coordy(npc_coord) | npc_range(coord) > 15) {
        npc_tele(map_findsquare(coord, 1, 1, ^map_findsquare_lineofwalk));
        spotanim_map(smokepuff, npc_coord, 124, 0);
        sound_synth(smokepuff, 1, 0);
    }
    npc_setmode(playerfollow);
    return(false);
}
return(true);

[proc,macro_event_lost_hostile]()(boolean)
if (finduid(%npc_macro_event_target) = true) {
    if (npc_getmode = wander & (npc_range(coord) > 3 | coordy(npc_coord) ! coordy(coord))) { // seems like distance of 3? https://www.youtube.com/watch?v=GoRX3cp58eo&list=PLn23LiLYLb1am4weMQzkWn5m9b3m9fXv9&t=38s
        return(true);
    }
    return(false);
}
return(true);
// based off https://web.archive.org/web/20060814111255/http://www.zybez.net/misc.php?id=11
[proc,macro_event_combat_level]()(int)
def_int $combat_level = ~player_combat_level;
if ($combat_level < 11) {
    return(^macro_event_cmb_14);
}
if ($combat_level < 21) {
    return(^macro_event_cmb_29);
}
if ($combat_level < 41) {
    return(^macro_event_cmb_49);
}
if ($combat_level < 61) {
    return(^macro_event_cmb_79);
}
if ($combat_level < 91) {
    return(^macro_event_cmb_120);
}

return(^macro_event_cmb_159);

// for 2x2 npcs
[proc,macro_event_coord_2x2]()(coord)
def_int $i = 0;
def_coord $sw;
def_coord $nw;
def_coord $se;
def_coord $ne;
// basically prevent the npc from spawning into anything it shouldnt. and so it doesnt spawn ontop of player
while ($i < 50) {
    $sw = movecoord(coord, ~random_range(-2, 2), 0, ~random_range(-2, 2));
    $nw = movecoord($sw, 1, 0, 0);
    $se = movecoord($sw, 0, 0, 1);
    $ne = movecoord($sw, 1, 0, 1);
    if (map_blocked($sw) = false & map_blocked($nw) = false & map_blocked($se) = false & map_blocked($ne) = false
        & $sw ! coord & $se ! coord & $nw ! coord & $ne ! coord
        & lineofwalk($sw, coord) = true
        ){
        return($sw);
    }
    $i = calc($i + 1);
}
return(null);

[proc,macro_events_set_tabs]
if_settab(null, 0);
if_settab(null, 1);
if_settab(null, 2);
if_settab(null, 3);
if_settab(null, 4);
if_settab(null, 5);
if_settab(null, 6);
if_settab(null, 11);
if_settab(null, 12);
if_settabactive(^tab_friends);

[proc,macro_events_varps_reset]
%macro_event = ^no_macro_event;
%macro_event_target_coord = null;
%macro_event_uid = null;

[proc,macro_return_teleport]
if(%macro_event_target_coord = null | map_blocked(%macro_event_target_coord) = true) {
    mes("Whoops, you couldn't be returned to where you came from.");
    p_teleport(map_findsquare(0_50_50_21_18, 0, 2, ^map_findsquare_lineofwalk));
    return;
}
p_teleport(%macro_event_target_coord);
